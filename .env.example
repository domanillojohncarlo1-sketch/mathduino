# ── Local development (default) ─────────────────────────────
# Plain SQLite file — created automatically by `bun run db:push`
DATABASE_URL="file:../db/custom.db"

# ── Production (Vercel) — Turso hosted SQLite ───────────────
# Sign up at https://turso.app → create a database → copy its URL,
# then create a database token. The app picks this mode automatically
# whenever DATABASE_URL starts with libsql://
#
# DATABASE_URL="libsql://mathduino-<you>.turso.io"
# DATABASE_AUTH_TOKEN="eyJ...   (the database token from Turso)"

# Used by `bun run db:push:turso` (creates tables in Turso; not read by the app)
# TURSO_DATABASE_URL="libsql://mathduino-<you>.turso.io"
# TURSO_AUTH_TOKEN="eyJ..."

# ── ESP32 machine sync ──────────────────────────────────────
# Shared secret the ESP32 station sends as X-Device-Key on /api/device/events.
# On Vercel, set the SAME value in the dashboard env vars.
MD_DEVICE_KEY="md-station-key-2025"
